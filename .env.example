# Server-only key used by the Eve runtime. Never expose it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Google Sheet holding the reading list, published to the web as CSV
# (File > Share > Publish to web > pick the sheet > CSV). Keep gid and
# single=true, otherwise a multi-tab document serves the wrong tab.
# Leaving it unset is a supported state: the reading page renders its failure
# copy and the home teaser hides itself.
BLOG_LINKS_CSV_URL=
